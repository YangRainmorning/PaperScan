<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <!--
      Built against the .NET 8 LTS targeting pack, but allowed to run on any newer runtime
      that happens to be installed. Without this a machine with only .NET 9 or 10 refuses
      to launch the tool even though nothing here needs 8 specifically.
    -->
    <RollForward>LatestMajor</RollForward>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <Product>PaperScan</Product>
    <Company>PaperScan contributors</Company>
    <Copyright>Copyright (c) 2026 PaperScan contributors</Copyright>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
